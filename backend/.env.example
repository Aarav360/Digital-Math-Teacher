# Digital Math Teacher – Backend
# Copy to .env and set values.

# App
APP_NAME="Digital Math Teacher API"
DEBUG=false

# API
API_V1_PREFIX=/api/v1

# Database (async driver)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/digital_math_teacher

# Auth (use openssl rand -hex 32 in production)
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Optional: Supabase
# SUPABASE_URL=
# SUPABASE_ANON_KEY=

# LLM
# OPENAI_API_KEY=

# Storage
# STORAGE_BUCKET=
